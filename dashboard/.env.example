# Public map URLs only. VITE_ variables are embedded at build time; never put keys here.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_RASTER_TILE_URL=https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png
# Private server configuration. Self-host these providers for production/privacy control.
PHOTON_URL=https://photon.komoot.io/
OVERPASS_URL=https://overpass-api.de/api/interpreter
VALHALLA_URL=https://valhalla1.openstreetmap.de
# Optional Valhalla server with local transit/GTFS data. No default transit schedules.
# TRANSIT_ROUTER_URL=https://your-transit-router.example
# ROUTING_API_KEY=server-only-provider-key
# Only enable with a tile source whose license/policy permits bulk offline downloads.
# OFFLINE_TILE_URL=https://your-tiles.example/{z}/{x}/{y}.png
# OFFLINE_TILE_ATTRIBUTION=© OpenStreetMap contributors · Your tile provider
