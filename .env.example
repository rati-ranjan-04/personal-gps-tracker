# Backend and Vercel proxy secret. Generate a long random value and keep it private.
API_TOKEN=replace-with-a-long-random-token
SECRET_KEY=replace-with-a-different-long-random-secret

# Use a managed PostgreSQL URL in production.
DATABASE_URL=sqlite:///./gps_tracker.db

# Optional Telegram bot settings.
TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_USER_ID=0

# Backend-only settings. Vercel defaults to the deployed Render URL when omitted.
BACKEND_URL=https://personal-gps-tracker.onrender.com
CORS_ORIGINS=https://personal-gps-tracker.vercel.app,http://localhost:8080,http://127.0.0.1:8080
